# Conexión a PostgreSQL / Supabase
# Usa la cadena "Session pooler" (o "Transaction pooler") que copia Supabase.
RUTA_DATABASE_URL=postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Alternativa con variables separadas (si no usas RUTA_DATABASE_URL)
# RUTA_DB_HOST=aws-0-TU_REGION.pooler.supabase.com
# RUTA_DB_PORT=5432
# RUTA_DB_NAME=postgres
# RUTA_DB_USER=postgres.TU_REF
# RUTA_DB_PASSWORD=TU_PASSWORD
# RUTA_DB_SSLMODE=require

# Clave para firmar la sesión del panel admin (mínimo 16 caracteres)
RUTA_APP_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
